# Keelwatch configuration. Copy to .env and fill in values.
# Every service (api, worker) reads this single root .env file.
# Never commit .env. Never put real secrets in this file.

# --- Application -------------------------------------------------------------
# One of: development, test, production
APP_ENV=development
# Version string reported by health endpoints and worker heartbeats
APP_VERSION=0.1.0
# Comma-separated list of browser origins allowed to call the API (CORS).
# In development the Vite dev server proxies /api, so this can stay empty.
API_CORS_ORIGINS=

# --- Database (MySQL 8.4+) ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keelwatch
DB_USER=keelwatch_app
DB_PASSWORD=
# Separate database used by integration tests (it is wiped by the tests)
DB_TEST_NAME=keelwatch_test
# Connect timeout in seconds for readiness probes
DB_CONNECT_TIMEOUT_S=2

# --- Worker ------------------------------------------------------------------
# How often each worker process writes a heartbeat row
WORKER_HEARTBEAT_INTERVAL_S=10
# A worker whose last heartbeat is older than this is reported as stale
WORKER_STALE_AFTER_S=35
# Optional stable name for this worker (defaults to hostname-pid)
WORKER_ID=
