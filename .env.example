# Keelwatch configuration. Copy to .env and fill in values.
# Every service (api, worker) reads this single root .env file.
# Never commit .env. Never put real secrets in this file.

# --- Application -------------------------------------------------------------
# One of: development, test, production
APP_ENV=development
# Version string reported by health endpoints and worker heartbeats
APP_VERSION=0.1.0
# Comma-separated list of browser origins allowed to call the API (CORS).
# In development the Vite dev server proxies /api, so this can stay empty.
API_CORS_ORIGINS=

# --- Dashboard sign-in -------------------------------------------------------
# Server secret (at least 32 characters) used to key login-throttling hashes.
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=
# Idle and absolute session lifetimes.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Cookies are Secure (HTTPS-only) in production. Set false only for plain-HTTP
# local development.
SESSION_COOKIE_SECURE=false

# --- Database (MySQL 8.4+) ---------------------------------------------------
# With Docker Compose, DB_HOST is set to the db service automatically and
# DB_NAME / DB_USER / DB_PASSWORD are used to create the database on first start.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keelwatch
DB_USER=keelwatch_app
DB_PASSWORD=
# Separate database used by integration tests (it is wiped by the tests)
DB_TEST_NAME=keelwatch_test
# Connect timeout in seconds for readiness probes
DB_CONNECT_TIMEOUT_S=2

# --- GitHub webhooks ---------------------------------------------------------
# The secret configured on the GitHub App's webhook. At least 20 characters;
# generate one with: php -r "echo bin2hex(random_bytes(32));"
GITHUB_WEBHOOK_SECRET=
# During rotation, put the old secret here so in-flight deliveries still verify.
GITHUB_WEBHOOK_SECRET_PREVIOUS=
# Largest accepted webhook body in bytes (GitHub caps payloads at 25 MB).
# PHP's post_max_size must be at least this large.
WEBHOOK_MAX_BODY_BYTES=5242880
# Failed signature checks allowed per client IP per window before HTTP 429.
WEBHOOK_FAILED_AUTH_LIMIT=20
WEBHOOK_FAILED_AUTH_WINDOW_S=300

# --- Queue monitoring --------------------------------------------------------
# System Health marks the queue degraded when a due job has waited longer than this
QUEUE_LAG_WARN_S=300

# --- Worker ------------------------------------------------------------------
# How often each worker process writes a heartbeat row
WORKER_HEARTBEAT_INTERVAL_S=10
# A worker whose last heartbeat is older than this is reported as stale
WORKER_STALE_AFTER_S=35
# Optional stable name for this worker (defaults to hostname-pid)
WORKER_ID=
# How long a claimed job is reserved before another worker may reclaim it
JOB_LEASE_S=60
# Idle wait between queue polls when there is no work
WORKER_POLL_INTERVAL_S=2
# Retry backoff: base * 2^(attempt-1), capped, with jitter
JOB_RETRY_BASE_S=5
JOB_RETRY_MAX_S=300
# Time budget for one analysis run (1000 - 3600000 ms)
ANALYSIS_BUDGET_MS=120000
# Held back from every run so there is always time to save the checkpoint
PHASE_CHECKPOINT_RESERVE_MS=2000

# --- GitHub API (worker) -----------------------------------------------------
# With both unset, the worker reads PUBLIC repositories anonymously (GitHub
# allows 60 requests/hour per IP) and skips private ones. To analyse private
# repositories, create a GitHub App with read-only Contents, Pull requests and
# Metadata permissions, then set its ID and the path to its private key file.
# The key stays on disk; never paste it into this file.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_API_URL=https://api.github.com

# --- Vulnerability lookups (worker) ------------------------------------------
# OSV.dev (free, no key). Only exact dependency versions are queried.
OSV_ENABLED=true
OSV_API_URL=https://api.osv.dev

# --- Digests and notifications (API + worker) ---------------------------------
# Digests are always stored. Notifications to Slack/Discord are off until this
# key is set: 32 random bytes, base64. It encrypts stored webhook URLs; the API
# encrypts when an admin adds a destination, the worker decrypts to send.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Changing it makes existing destinations undecryptable (re-add them).
NOTIFICATION_KEY=
# Optional link target in messages (https://, or http:// on localhost).
DASHBOARD_URL=
# Daily digests for the previous UTC day are queued after this UTC hour.
DIGEST_DAILY_HOUR_UTC=6
NOTIFY_TIMEOUT_S=10

# --- LLM providers (optional) -------------------------------------------------
# Ordered provider:model route. Empty = no LLM; analysis stays deterministic.
#   LLM_ROUTE=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash
LLM_ROUTE=
GROQ_API_KEY=
GEMINI_API_KEY=
# Data policy per provider: may_train (default) or no_training. Private code
# is only ever sent to providers set to no_training, and only for repos whose
# llm_policy is 'allowed'. Set no_training only after checking the provider's
# terms for your account tier.
GROQ_DATA_POLICY=may_train
GEMINI_DATA_POLICY=may_train
# Optional OpenAI-compatible gateway (e.g. a local OmniRoute). Off unless listed
# in LLM_ROUTE as openai_compatible:<model>. Never receives private code.
# https:// anywhere, or http:// only on localhost/127.0.0.1.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Per-call timeout (always capped by the remaining run budget), attempts per
# provider, and circuit breaker (open after N consecutive failures, retry after cooldown).
LLM_TIMEOUT_S=30
LLM_MAX_ATTEMPTS=2
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_S=120

# --- Docker Compose deployment (compose.yaml) ---------------------------------
# Only read by `docker compose`; see docs/deployment.md.
# Public host name. DNS must point at this server for automatic HTTPS
# certificates; "localhost" uses a locally trusted certificate instead.
KEELWATCH_DOMAIN=localhost
# MySQL root password, used only by the db container (generate a long one).
MYSQL_ROOT_PASSWORD=
# Host ports for HTTP (redirects to HTTPS) and HTTPS.
KEELWATCH_HTTP_PORT=80
KEELWATCH_HTTPS_PORT=443
# Image tag for locally built images.
KEELWATCH_VERSION=local
